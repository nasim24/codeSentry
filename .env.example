# ─────────────────────────────────────────────────────────────────
# CodeSentryAI — example configuration
#
# Everything here is OPTIONAL. You can configure the whole tool from
# the dashboard instead: http://localhost:3000/settings
#
# Values saved in the UI take precedence over this file. This file is
# useful for Docker/CI deployments, or if you prefer editing text.
#
# Copy to .env and fill in what you need:   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── GitLab (required) ────────────────────────────────────────────
# Token needs the 'api' scope AND at least the Developer role on the
# project. Scope alone is not enough: a Guest with 'api' authenticates
# fine, then gets 403 on every merge request call.
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# ── AI model (required) ──────────────────────────────────────────
# Reviews run locally through Ollama — no code leaves your network.
# Check installed models with: ollama list
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# ── Webhook & polling ────────────────────────────────────────────
# WEBHOOK_SECRET is generated automatically on first run if unset.
# Paste the same value into your GitLab project's webhook settings.
WEBHOOK_PORT=8001
WEBHOOK_SECRET=
POLL_INTERVAL=300

# Optional — only needed to expose the webhook to GitLab over the
# internet. Without it, polling still picks up new merge requests.
NGROK_AUTHTOKEN=

# ── Notifications (optional) ─────────────────────────────────────
GOOGLE_CHAT_WEBHOOK=

# ── Morning digest (optional) ────────────────────────────────────
# GMAIL_APP_PASSWORD is a Google App Password, not your account password.
GMAIL_FROM=
GMAIL_APP_PASSWORD=
GMAIL_TO=
DIGEST_TIME=09:00
