# ─────────────────────────────────────────────────────────────────
# Dashboard configuration (optional)
#
# The dashboard reads settings from reviewer.db, which the Settings
# page writes — so normally you do not need this file at all.
#
# It exists only as a fallback for the same variables used by the
# Python side. See ../.env.example for the full list.
# ─────────────────────────────────────────────────────────────────

GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
WEBHOOK_PORT=8001
